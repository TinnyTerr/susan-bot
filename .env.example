# --- Required ---
DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id
# If set, slash commands register instantly to this guild (recommended for dev).
# Leave blank to register globally (takes up to an hour to propagate).
GUILD_ID=

# --- Storage ---
# Path to the sqlite database file (created automatically).
DATABASE_PATH=./data/bot.sqlite

# --- Events / scheduling ---
# Channel events are posted to when no channel is specified in /event create.
# Leave blank to require the command be run in the target channel.
DEFAULT_EVENT_CHANNEL_ID=

# Comma-separated list of minutes-before-event to send reminders, e.g. "1440,60,15"
# (1 day, 1 hour, 15 minutes before). Use a single value like "10" for one reminder.
REMINDER_MINUTES_BEFORE=1440,60,15

# How often (ms) the bot checks whether a reminder or event start is due.
REMINDER_POLL_INTERVAL_MS=60000

# IANA timezone used when displaying dates, e.g. "America/New_York", "Europe/London".
TIMEZONE=UTC

# Locale used for date formatting, e.g. "en-US", "en-GB".
LOCALE=en-US

# Max number of upcoming events shown by /event list.
EVENT_LIST_MAX=10

# Comma-separated role IDs allowed to create/cancel/edit events.
# Leave blank to allow anyone.
EVENT_MANAGER_ROLE_IDS=

# Optional emoji for the RSVP buttons and embed headers (yes, maybe, no).
# Leave blank for plain text labels.
RSVP_EMOJI_YES=
RSVP_EMOJI_MAYBE=
RSVP_EMOJI_NO=

# Automatically delete an event's message/DB row this many hours after it starts.
# Set to 0 to disable auto-cleanup and keep events forever.
EVENT_CLEANUP_HOURS=24

# If "true", RSVPs get a "Details" button letting users specify arrival/departure
# time and a note, in addition to the basic Yes/Maybe/No buttons.
EVENT_ADVANCED_RSVP_ENABLED=true

# --- Cats ---
# Directory holding one subfolder per cat, e.g. ./media/cats/susan/ containing
# her photos and videos (jpg, png, gif, webp, mp4, mov, webm). /cat posts a
# random one.
CAT_MEDIA_DIR=./media/cats

# Cat used when /cat is run without a name. Set blank to pick a random cat.
CAT_DEFAULT_NAME=susan

# Skip files larger than this (Discord rejects uploads over 10 MB for most bots).
CAT_MAX_UPLOAD_BYTES=10485760

# --- Quiplash / prompt packs ---
# Default category used when none is specified.
QUIPLASH_DEFAULT_CATEGORY=general

# Default / maximum number of prompts returned by /quiplash random.
QUIPLASH_RANDOM_DEFAULT_COUNT=10
QUIPLASH_RANDOM_MAX_COUNT=50

# Comma-separated role IDs allowed to add/remove/import prompts.
# Leave blank to allow anyone.
QUIPLASH_MANAGER_ROLE_IDS=

# If "true", /quiplash random will not return the same prompt twice within
# the configured cooldown window (see QUIPLASH_COOLDOWN_HOURS) so games don't repeat.
QUIPLASH_AVOID_REPEATS=true
QUIPLASH_COOLDOWN_HOURS=24
